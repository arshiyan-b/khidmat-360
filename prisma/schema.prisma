// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────
// Enums
// ─────────────────────────────

enum UserRole {
  ADMIN
  ACCOUNTANT
  STAFF
}

enum DonationCategory {
  GENERAL
  CONSTRUCTION
  MAINTENANCE
  RAMADAN
  ZAKAT
  FITRAH
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  GAS
  CLEANING
  MAINTENANCE
  CONSTRUCTION
  SALARIES
  SECURITY
  OTHER
}

enum StaffRole {
  IMAM
  MUAZZIN
  TEACHER
  CLEANER
  SECURITY
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum SalaryPaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum EventCategory {
  JUMMAH
  TARAWEEH
  EID
  QURAN_CLASS
  LECTURE
  FUNDRAISING
  OTHER
}

// ─────────────────────────────
// Core models
// ─────────────────────────────

model Mosque {
  id      String @id @default(uuid())
  name    String
  address String?
  city    String?
  phone   String?
  email   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  donors    Donor[]
  donations Donation[]
  expenses  Expense[]
  staff     Staff[]
  events    Event[]
  assets    Asset[]

  @@map("mosques")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(STAFF)

  mosqueId String?
  mosque   Mosque? @relation(fields: [mosqueId], references: [id])

  sessions Session[]
  accounts Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id         String  @id @default(uuid())
  accountId  String
  providerId String
  password   String?

  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("verifications")
}

model Donor {
  id    String  @id @default(uuid())
  name  String
  phone String?
  email String?
  notes String?

  mosqueId String
  mosque   Mosque @relation(fields: [mosqueId], references: [id])

  donations Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("donors")
}

model Donation {
  id            String           @id @default(uuid())
  amount        Decimal          @db.Decimal(12, 2)
  category      DonationCategory @default(GENERAL)
  purpose       String?
  paymentMethod PaymentMethod    @default(CASH)
  receiptNumber String?          @unique
  donationDate  DateTime         @default(now())

  donorId String?
  donor   Donor?  @relation(fields: [donorId], references: [id])

  mosqueId String
  mosque   Mosque @relation(fields: [mosqueId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mosqueId, donationDate])
  @@map("donations")
}

model Expense {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory @default(OTHER)
  description String?
  expenseDate DateTime        @default(now())

  mosqueId String
  mosque   Mosque @relation(fields: [mosqueId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mosqueId, expenseDate])
  @@map("expenses")
}

model Staff {
  id          String      @id @default(uuid())
  name        String
  role        StaffRole   @default(OTHER)
  phone       String?
  email       String?
  joiningDate DateTime    @default(now())
  salary      Decimal     @db.Decimal(12, 2)
  status      StaffStatus @default(ACTIVE)

  mosqueId String
  mosque   Mosque @relation(fields: [mosqueId], references: [id])

  salaryPayments SalaryPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff")
}

model SalaryPayment {
  id           String              @id @default(uuid())
  amount       Decimal             @db.Decimal(12, 2)
  month        Int // 1-12
  year         Int
  status       SalaryPaymentStatus @default(PENDING)
  paymentDate  DateTime?

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, month, year])
  @@map("salary_payments")
}

model Event {
  id          String        @id @default(uuid())
  title       String
  category    EventCategory @default(OTHER)
  description String?
  startsAt    DateTime
  endsAt      DateTime?

  mosqueId String
  mosque   Mosque @relation(fields: [mosqueId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mosqueId, startsAt])
  @@map("events")
}

model Asset {
  id            String   @id @default(uuid())
  name          String
  description   String?
  purchaseDate  DateTime?
  purchaseValue Decimal? @db.Decimal(12, 2)
  condition     String?

  mosqueId String
  mosque   Mosque @relation(fields: [mosqueId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assets")
}
